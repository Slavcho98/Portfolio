# Copy to .env (never commit .env).

# Local MongoDB (the service Compass connects to):
MONGODB_URI=mongodb://127.0.0.1:27017/velvora

# MongoDB Atlas: Connect -> Drivers -> copy the string, replace <password>, and keep "/velvora" before the "?"
# MONGODB_URI=mongodb+srv://velvora_app:<password>@cluster0.xxxxx.mongodb.net/velvora?retryWrites=true&w=majority&appName=Velvora
